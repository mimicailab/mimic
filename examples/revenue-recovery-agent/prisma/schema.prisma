generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────────────────────────
// Enums — values previously listed in `// comment` form on plain String columns.
// Declaring them as real enums lets mimic's expander coerce LLM-emitted
// synonyms back to canonical values and lets Postgres reject anything else
// at insert time. Synonyms the LLM frequently produces (e.g. `card_expired`
// ↔ `expired_card`) are normalized by mimic's `coerceEnumColumns` pass via
// token-sorted matching.
// ────────────────────────────────────────────────────────────────────────────

enum Plan {
  starter
  pro
  enterprise
}

enum CustomerStatus {
  active
  past_due
  canceled
  churned
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
}

enum BillingInterval {
  month
  year
}

enum InvoiceStatus {
  draft
  open
  paid
  void
  uncollectible
}

enum PaymentStatus {
  succeeded
  failed
  refunded
}

enum FailureReason {
  insufficient_funds
  card_declined
  expired_card
  lost_card
  fraudulent
}

enum RiskFlagType {
  billing_dispute
  churn_risk
  support_escalation
  contract_concern
  competitor_mentioned
}

enum Severity {
  low
  medium
  high
}

/// Subscription customer. mrr_cents is the source-of-truth MRR carried in Postgres;
/// reconciliation skill compares this against the live Stripe subscription state.
model customers {
  id                 Int             @id @default(autoincrement())
  name               String
  email              String          @unique
  company            String?
  stripe_customer_id String?         @unique
  plan               Plan            @default(starter)
  status             CustomerStatus  @default(active)
  mrr_cents          Int             @default(0)
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  subscriptions      subscriptions[]
  invoices           invoices[]
  payments           payments[]
  risk_flags         risk_flags[]
  support_notes      support_notes[]
}

model subscriptions {
  id                     Int                @id @default(autoincrement())
  customer_id            Int
  stripe_subscription_id String?            @unique
  plan                   Plan               @default(starter)
  status                 SubscriptionStatus @default(active)
  interval               BillingInterval    @default(month)
  amount_cents           Int
  current_period_start   DateTime
  current_period_end     DateTime
  canceled_at            DateTime?
  /// Free-text reason captured at cancellation. Mirrors Stripe's cancellation_details.reason
  /// when available, otherwise filled from internal exit interview / support context.
  cancellation_reason    String?
  created_at             DateTime           @default(now())
  customer               customers          @relation(fields: [customer_id], references: [id])
}

model invoices {
  id                Int           @id @default(autoincrement())
  customer_id       Int
  stripe_invoice_id String?       @unique
  amount_cents      Int
  status            InvoiceStatus @default(draft)
  due_date          DateTime
  paid_at           DateTime?
  created_at        DateTime      @default(now())
  customer          customers     @relation(fields: [customer_id], references: [id])
}

model payments {
  id                       Int            @id @default(autoincrement())
  customer_id              Int
  stripe_payment_id        String?        @unique
  stripe_payment_intent_id String?        @unique
  amount_cents             Int
  currency                 String         @default("usd")
  status                   PaymentStatus  @default(succeeded)
  payment_method           String         @default("card")
  /// Decline reason on failed charges. Drives retry-probability ranking in payment-failures skill.
  failure_reason           FailureReason?
  created_at               DateTime       @default(now())
  customer                 customers      @relation(fields: [customer_id], references: [id])
}

/// Internal at-risk markers set by CSM, support, or automated heuristics.
/// Correlated with churn in the risk-signals skill — finds the "we knew this was coming" cases.
model risk_flags {
  id          Int          @id @default(autoincrement())
  customer_id Int
  flag_type   RiskFlagType
  severity    Severity     @default(medium)
  /// User identifier (CSM, support agent, or "system") who set the flag.
  set_by      String
  set_at      DateTime     @default(now())
  resolved_at DateTime?
  note        String?
  customer    customers    @relation(fields: [customer_id], references: [id])

  @@index([customer_id, set_at])
}

/// Free-text notes from support tickets, sales calls, CSM check-ins.
/// Searched by reconciliation + churn-investigation skills to surface the human context
/// behind the numbers — e.g. "considering competitor", "billing complaint", "downgrade requested".
model support_notes {
  id          Int       @id @default(autoincrement())
  customer_id Int
  author      String
  body        String    @db.Text
  /// Comma-separated lightweight tags: billing, churn-risk, downgrade, escalation, etc.
  tags        String?
  created_at  DateTime  @default(now())
  customer    customers @relation(fields: [customer_id], references: [id])

  @@index([customer_id, created_at])
}
